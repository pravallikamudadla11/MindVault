PORT=5000
# MongoDB Atlas: replace the placeholders with your Atlas database user and cluster.
# Example: mongodb+srv://<username>:<password>@<cluster-host>/mindvault?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/mindvault?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173
